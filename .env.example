# Real-Time Stock Data Pipeline - environment variables

# Explicitly choose generated demonstration ticks or Finnhub live ticks.
# DATA_MODE=live requires FINNHUB_API_KEY.
DATA_MODE=simulation

# Optional in simulation mode. Never commit a real key.
FINNHUB_API_KEY=

# Optional. Historical/fundamental panels report unavailable or demo-labelled data
# when the configured provider cannot return a verified result.
POLYGON_API_KEY=

# Kafka
KAFKA_TOPIC=stock.raw-ticks.v1

# PostgreSQL
POSTGRES_DB=stock_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Stock symbols to track (comma-separated, no spaces)
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,TSLA,NVDA,META,NFLX,AMD,INTC,JPM,V,WMT,JNJ,PG,MA,UNH,HD,BAC,DIS

# Producer tick frequency in milliseconds (simulation mode only)
TICK_INTERVAL_MS=500
