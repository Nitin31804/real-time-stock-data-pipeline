# Real-Time Stock Data Pipeline ?" Environment Variables

# Finnhub API key (https://finnhub.io ?" free tier)
# Used for real-time Websocket data ingestion
FINNHUB_API_KEY=your_finnhub_api_key_here

# Polygon API key (https://polygon.io/ ?" free tier)
# Used for historical chart data and fundamentals
POLYGON_API_KEY=your_polygon_api_key_here

# Kafka
KAFKA_TOPIC=stock.raw-ticks.v1

# PostgreSQL / TimescaleDB
POSTGRES_DB=stock_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Stock symbols to track (comma-separated, no spaces)
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,TSLA,NVDA,META,NFLX,AMD,INTC,JPM,V,WMT,JNJ,PG,MA,UNH,HD,BAC,DIS

# Producer tick frequency in milliseconds (mock mode only)
TICK_INTERVAL_MS=500
